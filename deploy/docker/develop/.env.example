# Copie para .env e defina todos os segredos antes de executar.
COMPOSE_PROJECT_NAME=reforma-tributaria-docker-develop
IMAGE_OWNER=wkarts
APP_TAG=develop
APP_ENV=development
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=48081
SECRET_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
POSTGRES_DB=fiscal
POSTGRES_USER=fiscal
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_DEFAULT_USER=fiscal
RABBITMQ_DEFAULT_PASS=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=objectstore:9000
S3_BUCKET=fiscal-evidence
S3_REGION=us-east-1
S3_USE_SSL=false
PROVIDER_MODE=fixture
CBS_RESTRICTED_ENABLED=false
CBS_PRODUCTION_ENABLED=false
CBS_PAYMENTS_ENABLED=false
CBS_ALLOWED_BASES=
CBS_CREDENTIAL_ORGANIZATION_ID=
CBS_TOKEN_URL=
CBS_CLIENT_ID=
CBS_CLIENT_SECRET=
CBS_WEBHOOK_BASE_URL=
CBS_DOWNLOAD_HOSTS=storagegw.estaleiro.serpro.gov.br,api.receitafederal.gov.br
CBS_MAX_DOWNLOAD_BYTES=100000000
CBS_AUTO_SYNC_ENABLED=false
CBS_AUTO_SYNC_ENVIRONMENT=restricted
CBS_AUTO_SYNC_RESOURCES=debitos,creditos

# Motor tributário local opcional: informar apenas endpoints oficiais verificados.
TAX_CALCULATOR_REGULAR_URL=
TAX_CALCULATOR_REGULAR_VERSION_URL=
TAX_CALCULATOR_SIMPLES_URL=
TAX_CALCULATOR_SIMPLES_VERSION_URL=

# Cadastro cadastral público de CNPJ (dados terceiros).
CNPJ_LOOKUP_ENABLED=true
# SMTP para convites, recuperação e notificações de usuários.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
SMTP_STARTTLS=true
SMTP_SSL=false
APP_PUBLIC_URL=
