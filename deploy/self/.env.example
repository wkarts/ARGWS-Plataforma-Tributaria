# Crie com: python deploy/self/init_secrets.py --project nome-da-instalacao --email admin@exemplo.com
COMPOSE_PROJECT_NAME=
BOOTSTRAP_ADMIN_EMAIL=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=48080

# Integração CBS desabilitada por padrão. A configuração exige credenciais
# autorizadas da matriz e webhook HTTPS público, testados pelo operador.
PROVIDER_MODE=disabled
CBS_TOKEN_URL=
CBS_CLIENT_ID=
CBS_CLIENT_SECRET_FILE=
CBS_WEBHOOK_BASE_URL=
CBS_CREDENTIAL_ORGANIZATION_ID=
CBS_ALLOWED_BASES=
CBS_RESTRICTED_ENABLED=false
CBS_PRODUCTION_ENABLED=false
CBS_PAYMENTS_ENABLED=false
CBS_AUTO_SYNC_ENABLED=false

# Motor de cálculo local: sem fallback de alíquotas; informe rotas /api/ e /versao do componente instalado.
TAX_CALCULATOR_REGULAR_URL=
TAX_CALCULATOR_REGULAR_VERSION_URL=
TAX_CALCULATOR_SIMPLES_URL=
TAX_CALCULATOR_SIMPLES_VERSION_URL=
