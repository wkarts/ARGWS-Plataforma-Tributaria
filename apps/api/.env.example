DEPLOYMENT_MODE=central
APP_ENV=development
SELF_DATA_DIR=./data
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fiscal
POSTGRES_USER=fiscal
POSTGRES_PASSWORD=
RABBITMQ_HOST=rabbitmq
RABBITMQ_DEFAULT_USER=fiscal
RABBITMQ_DEFAULT_PASS=
REDIS_HOST=redis
REDIS_PASSWORD=
S3_ENDPOINT=objectstore:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=cbs-raw
S3_REGION=us-east-1
SECRET_KEY=
SECRET_KEY_FILE=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD_FILE=
PROVIDER_MODE=disabled
CBS_RESTRICTED_ENABLED=false
CBS_PRODUCTION_ENABLED=false
CBS_PAYMENTS_ENABLED=false
CBS_ALLOWED_BASES=
CBS_CREDENTIAL_ORGANIZATION_ID=
CBS_TOKEN_URL=
CBS_CLIENT_ID=
CBS_CLIENT_SECRET=
CBS_WEBHOOK_BASE_URL=
CBS_DOWNLOAD_HOSTS=storagegw.estaleiro.serpro.gov.br,api.receitafederal.gov.br
CBS_MAX_DOWNLOAD_BYTES=100000000
CBS_AUTO_SYNC_ENABLED=false
CBS_AUTO_SYNC_ENVIRONMENT=restricted
CBS_AUTO_SYNC_RESOURCES=debitos,creditos

# Motor de cálculo local: sem fallback de alíquotas; informe rotas /api/ e /versao do componente instalado.
TAX_CALCULATOR_REGULAR_URL=
TAX_CALCULATOR_REGULAR_VERSION_URL=
TAX_CALCULATOR_SIMPLES_URL=
TAX_CALCULATOR_SIMPLES_VERSION_URL=
S3_USE_SSL=false

# CNPJ: consulta cadastral opcional via BrasilAPI pública; não é Receita oficial.
CNPJ_LOOKUP_ENABLED=true
# SMTP deve ser parametrizado no cliente. Em produção use remetente e HTTPS próprios.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
APP_PUBLIC_URL=
